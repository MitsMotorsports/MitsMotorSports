{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*\\.(png|jpg|jpeg|gif|svg|mp4|webm|mp3|wav|ico|css|js|woff|woff2|ttf|otf|eot))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.(png|jpg|jpeg|gif|svg|mp4|webm|mp3|wav|ico|css|js|woff|woff2|ttf|otf|eot|json)).*)",
      "destination": "/index.html"
    }
  ]
}
